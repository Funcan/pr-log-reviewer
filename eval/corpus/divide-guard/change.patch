@@ -10,6 +10,9 @@ func Multiply(a, b float64) float64 {
 
 // Divide returns a divided by b.
-func Divide(a, b float64) float64 {
-	return a / b
+func Divide(a, b float64) (float64, error) {
+	if b == 0 {
+		return 0, errors.New("calc: divide by zero")
+	}
+	return a / b, nil
 }
